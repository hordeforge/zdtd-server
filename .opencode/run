#!/usr/bin/env bash
# Run OpenCode with Grok CLI auth (token from ~/.grok/auth.json or XAI_API_KEY).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
KEY_HELPER="$ROOT/.claude/grok-api-key.sh"

if [[ -z "${XAI_API_KEY:-}" ]]; then
  if [[ -x "$KEY_HELPER" ]]; then
    XAI_API_KEY="$("$KEY_HELPER")"
  else
    # Fallback if Claude helper is missing
    if [[ -n "${GROK_AUTH_FILE:-}" || -f "$HOME/.grok/auth.json" ]]; then
      auth_file="${GROK_AUTH_FILE:-$HOME/.grok/auth.json}"
      XAI_API_KEY="$(jq -r 'to_entries[0].value.key // empty' "$auth_file")"
    fi
  fi
fi

if [[ -z "${XAI_API_KEY:-}" ]]; then
  echo "opencode/run: no XAI_API_KEY (run: grok login)" >&2
  exit 1
fi

export XAI_API_KEY
cd "$ROOT"
exec opencode "$@"
