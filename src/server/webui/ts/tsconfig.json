{
  "compilerOptions": {
    "target": "es2022",
    // ESNext + bundler resolution: shell.tsx imports `preact` and the build
    // bundles it (ADR 0040); login.ts/lockout.ts stay import-free classic page
    // scripts and bundle to a tiny IIFE. oxlint's type-aware loader (tsgolint,
    // see lint-webui.sh) rejects module "none", which is the other reason for
    // the non-classic module setting.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    // Strict beyond `strict`: every flag below was verified against the tree
    // (tsc 5.9.3, 2026-08-23) and passes clean. Diagnostics only: none of them
    // changes emit.
    // noUncheckedIndexedAccess / noPropertyAccessFromIndexSignature were tried
    // and do NOT pass yet (apm sample and dataset indexing); enable once the
    // sources are narrowed.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "noEmitOnError": true,
    "types": [],
    // shadcn's alias contract (components.json): `@/...` is this directory, so
    // the primitives and cn() import the way the registry sources do. tsc and
    // bun build both read these paths; oxlint resolves the component alias from
    // the staged copy of this file beside the sources it lints. No baseUrl:
    // paths are relative to this file, and tsgolint rejects the option.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "files": [
    "login.ts",
    "lockout.ts",
    "shell.tsx",
    "chart.ts",
    "lib/utils.ts",
    "components/ui/alert.tsx",
    "components/ui/badge.tsx",
    "components/ui/button.tsx",
    "components/ui/card.tsx",
    "components/ui/input.tsx",
    "components/ui/progress.tsx",
    "components/ui/table.tsx"
  ]
}
