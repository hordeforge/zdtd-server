# zdtd.toml - operator tunables (Bucket B). Not stock serverconfig.
# Copy to <world>/zdtd.toml or CWD. Precedence:
#   CLI > env (webui secret) > world/zdtd.toml > CWD zdtd.toml >
#   mode pack > --serverconfig keys > code defaults
# Do not put secrets, MaxFuel, biome colors, item ids, or EconomicValue here.
# Web UI secret: env ZDTD_WEBUI_SECRET (see .env.example), never this file.
# Unknown keys and malformed assignments abort startup.
# See docs/reviews/HARDCODE_AUDIT.md and docs/GAME_OPTIONS.md.

[stream]
max_streamed_chunks = 169
chunk_adds_per_stream_tick = 8
stream_radius_min = 7
stream_radius_max = 9
# chunk_stream_period_ticks = 5
# motion_replicate_period_ticks = 2
# world_time_send_ticks = 20
# vehicle_pos_send_ticks = 5
# sleeper_tick_ticks = 10
# turret_sync_ticks = 10
# save_interval_ticks = 100
# spawn_area_radius_max = 8

[authority]
interest_range_blocks = 160.0
max_edit_range_blocks = 96.0
# Movement anti-cheat envelope: max accepted horizontal speed in m/s. Raise it
# for servers running faster vehicles or speed buffs, lower it to tighten the
# clamp. Must be finite and > 0.
# max_horizontal_speed_mps = 20.0
max_claimed_damage = 200
peer_stale_ms = 3000
# Join rate-limit gap per IP (stock paces ~500 ms/IP; loopback is exempt).
# join_rate_limit_ms = 500
# Container/trade lock auto-release after the holding peer goes silent.
# lock_stale_ms = 120000
# mode = "correct"   # observe | permissive | correct

# P4 guard policy (docs/AUTHORITY.md). Defaults are log-only: a tripped gate
# only prints "guard would kick" and bumps guard_would_kicks. Both enforcement
# rungs additionally require mode = "correct".
# guard_enforce = false        # master switch for the kick rung
# guard_dry_run = true         # with enforce: simulate the kick, do not drop
# guard_quarantine = false     # allow per-surface C2S denial bits
# guard_load_shed = true       # shed weak evidence + deferrable broadcasts on overrun
# guard_window_ticks = 1200    # counting window (1200 = 60 s at 20 TPS)
# guard_strong_distinct = 2    # distinct Strong detectors in a window that trip
# guard_hard_repeat = 25       # Hard events in a window that trip
# guard_kick_delay_ticks = 10  # ticks between the deny send and the peer drop
#                             # (stock disconnectLater(0.5f) = 10 at 20 TPS)
# guard_shed_hold_ticks = 40   # ticks the load-shed valve stays open (2 s)
# guard_weak_break_rate = 900  # block destroys per window that trip the weak
#                             # farming signal (record-only, cannot kick)

[feature]
wire_chunks = true
# Join-time deco trees (single DecoUpdate burst around spawn). Set false to send
# the empty firstPackage only (bald world) when the client's block AssignIds may
# differ from the bundled V3.1.4 dump, e.g. a modded or other-version client.
deco_trees = true
# Write the join deco burst into the server block store, so collision and harvest
# agree with what the client renders. False leaves deco render-only.
deco_mirror = true
# Send the full "blocks" NameIdMapping before the config files, so the client
# assigns block ids from our AssignIds dump instead of its own blocks.xml. Set
# false for a modded client whose block set differs from ours.
block_id_mapping = true
# Cap on deco objects sent in the join burst (needs deco_trees = true).
# deco_objects_per_join = 8192

# Sim policy that is not stock serverconfig and not stock game data.
[sim]
# Trader AvailableMoney display pool. Stock Traders.xml has no wallet key
# (AvailableMoney is engine-managed per-day); zdtd has no trader economy, so
# trade() credits the player wallet directly and this is a display value.
# trader_wallet_dukes = 5000
# Anti-abuse per-peer gates (mono-ns values; defaults match the code constants).
# min_chat_gap_ns = 200000000
# inv_bucket_cap = 40
# inv_refill_ns = 50000000
# block_bucket_cap = 30
# block_refill_ns = 33000000
# min_damage_gap_ns = 80000000
# damage_burst_max = 4
# Trader restock refill policy (stackables grow toward the cap each restock).
# trader_restock_cap = 50
# trader_restock_refill = 10
# Max craft batch a client can request in one InvTx craft.
# craft_max_times = 20
# Storm frequency percent (World::StormFrequency; default 100 = 1.0x, 0 disables
# storms). No stock V3.1.0 serverconfig key; feeds the weather scheduler and
# the GameStats wire value.
# storm_frequency = 100
# Per-chunk storage/prefab TE scan caps (engineering budgets: bound one chunk
# fill so a 65536-cell walk cannot stall the 50 ms tick).
# te_scan_block_cap = 32
# te_scan_te_cap = 48
# Workstation craft budgets: max crafts advanced per tick per station, and the
# largest client-written CraftingTimeLeft backlog (seconds) accepted.
# workstation_crafts_per_tick = 64
# workstation_craft_backlog = 60

# Operator metrics cadence (docs/APM.md). 0 disables the periodic dump.
# [apm]
# dump_every_s = 60

# Optional gamemode pack under modes/<name>.toml (ADR 0010). CLI --mode wins.
# [mode]
# name = "default"

# Performance switches (docs/SCALE.md). All default OFF. Each one
# trades a documented property, so turn one on only after its always-on apm
# section shows the cost it removes (save_encode / save_flush_wait,
# terrain_snap, sleeper_scan).
# [perf]
# async_chunk_flush = false  # write chunk saves on a background thread
#                            # (encode stays on the tick). Auto-disabled under
#                            # forced-serial / DST, where io_fs write-fault
#                            # injection must still see the error return.
# terrain_snapshot = false   # per-tick read-only terrain blocked snapshot; the
#                            # A* inner loop then skips the global terrain lock.
#                            # Behaviour-identical (misses use the locked hook).
# job_batches = false        # run the sleeper-volume player test in parallel.
#                            # Spawns stay serial in volume order (seed is vi).

# Wasm plugins (ADR 0020, docs/PLUGIN_DEV.md). Comma-separated .wasm module
# paths; each loads once at startup under a fuel + memory budget. A missing or
# unloadable module is logged and skipped; on_tick runs late in every tick.
# [plugin]
# modules = "mods/my_plugin.wasm, mods/stats.wasm"
# fuel = 100000000      # per-instance fuel budget (never re-armed; lower bounds a hostile guest)
# max_pages = 1024      # max linear-memory pages per instance

# Mod tiers and override (PRD 0005, docs/PLUGIN_DEV.md). Mods are auto-discovered
# from mods/<name>/mod.toml at boot; disable or blacklist any non-core mod by
# name here (core components cannot be disabled or blacklisted). Blacklisted
# mods are refused, and any mod overriding or requiring a blacklisted name is a
# load failure.
# [mods]
# disabled = "zdtd_killfeed"   # skip loading, one info log per mod
# blacklist = "evil_mod"       # refuse; also vetoes overrides/requires of it

# Sim rule overlay (ADR 0021, docs/GAME_OPTIONS.md "[rules] sim rules"). Both
# this file and a mode pack can set [rules.*]; the operator's zdtd.toml wins
# over the pack for the same key. Defaults equal the code constants.
# [rules.combat]
# attack_damage = 8.0        # floor: items.xml DamageEntity wins when non-zero
# attack_range_sq = 4.0      # melee reach, squared blocks
# attack_cooldown_s = 1.2    # strike cadence, seconds
# [rules.ai]
# sense_dist_sq = 2304.0     # 48^2 sense range, squared blocks
# chase_speed = 2.2          # floor: entityclasses MoveSpeedAggro wins when set
# wander_speed = 0.8         # floor: entityclasses MoveSpeed wins when set
# [rules.bloodmoon]
# party_enemy_max = 30       # per-party alive ceiling
# max_parties = 8            # concurrent parties (clamped to the storage cap)
