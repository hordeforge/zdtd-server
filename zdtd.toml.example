# zdtd.toml — operator tunables (Bucket B). Not stock serverconfig.
# Copy to <world>/zdtd.toml or CWD. Precedence:
#   CLI > env (webui secret) > world/zdtd.toml > CWD zdtd.toml >
#   mode pack > --serverconfig keys > code defaults
# Do not put secrets, MaxFuel, biome colors, item ids, or EconomicValue here.
# Web UI secret: env ZDTD_WEBUI_SECRET (see .env.example), never this file.
# Unknown keys and malformed assignments abort startup.
# See docs/HARDCODE_AUDIT.md and docs/GAME_OPTIONS.md.

[stream]
max_streamed_chunks = 169
chunk_adds_per_stream_tick = 8
stream_radius_min = 7
stream_radius_max = 9
# chunk_stream_period_ticks = 5
# motion_replicate_period_ticks = 2
# spawn_area_radius_max = 8

[authority]
interest_range_blocks = 160.0
max_edit_range_blocks = 96.0
max_claimed_damage = 200
peer_stale_ms = 3000
# mode = "correct"   # observe | permissive | correct

# P4 guard policy (docs/AUTHORITY.md). Defaults are log-only: a tripped gate
# only prints "guard would kick" and bumps guard_would_kicks. Both enforcement
# rungs additionally require mode = "correct".
# guard_enforce = false        # master switch for the kick rung
# guard_dry_run = true         # with enforce: simulate the kick, do not drop
# guard_quarantine = false     # allow per-surface C2S denial bits
# guard_load_shed = true       # shed weak evidence + deferrable broadcasts on overrun
# guard_window_ticks = 1200    # counting window (1200 = 60 s at 20 TPS)
# guard_strong_distinct = 2    # distinct Strong detectors in a window that trip
# guard_hard_repeat = 25       # Hard events in a window that trip

[feature]
wire_chunks = true
# Join-time deco trees (single DecoUpdate burst around spawn). Set false to send
# the empty firstPackage only (bald world) when the client's block AssignIds may
# differ from the bundled V3.1.4 dump, e.g. a modded or other-version client.
deco_trees = true
# Write the join deco burst into the server block store, so collision and harvest
# agree with what the client renders. False leaves deco render-only.
deco_mirror = true
# Send the full "blocks" NameIdMapping before the config files, so the client
# assigns block ids from our AssignIds dump instead of its own blocks.xml. Set
# false for a modded client whose block set differs from ours.
block_id_mapping = true

# Sim policy that is not stock serverconfig and not stock game data.
[sim]
# Trader AvailableMoney display pool. Stock Traders.xml has no wallet key
# (AvailableMoney is engine-managed per-day); zdtd has no trader economy, so
# trade() credits the player wallet directly and this is a display value.
# trader_wallet_dukes = 5000

# Optional gamemode pack under modes/<name>.toml (ADR 0010). CLI --mode wins.
# [mode]
# name = "default"

# Performance switches (docs/SCALE_ARCHITECTURE.md). All default OFF. Each one
# trades a documented property, so turn one on only after its always-on apm
# section shows the cost it removes (save_encode / save_flush_wait,
# terrain_snap, sleeper_scan).
# [perf]
# async_chunk_flush = false  # write chunk saves on a background thread
#                            # (encode stays on the tick). Auto-disabled under
#                            # forced-serial / DST, where io_fs write-fault
#                            # injection must still see the error return.
# terrain_snapshot = false   # per-tick read-only terrain blocked snapshot; the
#                            # A* inner loop then skips the global terrain lock.
#                            # Behaviour-identical (misses use the locked hook).
# job_batches = false        # run the sleeper-volume player test in parallel.
#                            # Spawns stay serial in volume order (seed is vi).

# Wasm plugins (ADR 0020, docs/PLUGIN_DEV.md). Comma-separated .wasm module
# paths; each loads once at startup under a fuel + memory budget. A missing or
# unloadable module is logged and skipped; on_tick runs late in every tick.
# [plugin]
# modules = "mods/my_plugin.wasm, mods/stats.wasm"
