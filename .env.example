# zdtd environment variables (optional).
# Copy to .env only if your process manager loads it; the binary reads the
# process environment (e.g. export, systemd Environment=, docker -e).
# Never commit real secrets. Prefer env over --webui-secret (visible in ps).
#
# Join password is ServerPassword in serverconfig.xml (see serverconfig.example.xml),
# not an environment variable. Do not put passwords or webui secrets in zdtd.toml.

# Shared secret for the operator web UI when --webui-port is non-zero.
# Required if webui is enabled. Minimum 8 characters; printable ASCII without
# whitespace, quotes, backslash, comma, or semicolon.
# ZDTD_WEBUI_SECRET=replace-with-a-long-random-string
