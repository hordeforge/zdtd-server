{
  // oxlint config for the webui TypeScript sources (src/server/webui/ts,
  // scripts/lint-webui.sh, `make lint`). Warnings fail too (--deny-warnings).
  //
  // Three rule sources, each taken whole:
  //   * @rikalabs/oxlint-standards `strict` + `strict-web` (the pages are
  //     Preact JSX): every oxlint category at error (correctness, suspicious,
  //     pedantic, perf, style, restriction, nursery) plus the @rikalabs/*
  //     plugin rules. lint-webui.sh flattens the chain into
  //     strict-resolved.json beside this file, dropping only the builtin
  //     rules the pinned oxlint does not implement (it names them on stderr).
  //   * dmmulroy/anti-slop: every generic rule (the Effect group needs Effect,
  //     which these pages do not use). Vendored source at a pinned SHA.
  //   * @shadcn/lint: every rule, against the contract in components.json and
  //     webui.css and the primitives in ts/components/ui.
  //
  // `rules` below adds thresholds stricter than the baseline and turns off
  // the few baseline rules that do not apply here, each with its reason.
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["./strict-resolved.json"],
  "options": { "typeAware": true },
  "env": { "browser": true, "es2024": true },
  "jsPlugins": [
    "@rikalabs/oxlint-standards/plugin",
    { "name": "anti-slop", "specifier": "./anti-slop-src/index.js" },
    "@shadcn/lint"
  ],
  "settings": {
    "shadcn": {
      "note": "zdtd webui: the shadcn token contract lives in src/server/webui/webui.css (:root plus @theme inline) and the primitives in src/server/webui/ts/components/ui. Restyle a component in its own file, not at the call site.",
      "ui": "@/components/ui",
      "componentImports": ["^preact(/|$)"]
    },
    "react": { "version": "19.0.0" }
  },
  "overrides": [
    {
      // The primitives own their classes and forward className by design.
      "files": ["**/components/ui/**"],
      "rules": { "shadcn/no-restyle": "off" }
    },
    {
      // Import-free page scripts, bundled as IIFEs (build-webui-ts.sh), so
      // their top-level declarations are never globals.
      "files": ["**/login.ts", "**/lockout.ts"],
      "rules": {
        "import/unambiguous": "off",
        "no-implicit-globals": "off"
      }
    },
    {
      // lib/utils.ts is the path components.json names as aliases.utils and
      // every registry component imports cn() from; renaming breaks the
      // shadcn contract.
      "files": ["**/lib/utils.ts"],
      "rules": { "@rikalabs/no-generic-module-names": "off" }
    }
  ],
  "rules": {
    // ---- stricter than the baseline ----
    "complexity": ["error", { "max": 15 }],
    "max-depth": ["error", { "max": 4 }],
    "max-nested-callbacks": ["error", { "max": 3 }],
    "max-params": ["error", { "max": 4 }],
    "no-negated-condition": "error",
    "no-implicit-coercion": ["error", { "allow": ["!!"] }],
    // -1 is the last-index (`.at(-1)`) and not-found sentinel.
    "no-magic-numbers": ["error", { "ignore": [-1, 0, 1, 2], "ignoreDefaultValues": true, "ignoreArrayIndexes": true }],
    // A wrapped comment continues its sentence; only its first line is
    // capitalized.
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],

    // ---- anti-slop: every generic rule ----
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",

    // ---- @shadcn/lint: every rule ----
    // Layout at a call site (placement, width, grid) is the page's business;
    // padding, color, shape and typography belong to the component.
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": ["error", { "allow": ["transform"] }],
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",

    "jsx-a11y/label-has-associated-control": ["error", { "assert": "htmlFor" }],
    // A scrollable region or log must take keyboard focus to be scrolled
    // without a pointer (WCAG 2.1.1).
    "jsx-a11y/no-noninteractive-tabindex": ["error", { "tags": ["section", "pre"] }],

    // ---- baseline rules that do not apply, each with its reason ----
    // The lockout page's server-injected global is the only dunder name.
    "no-underscore-dangle": ["error", { "allow": ["__ZDTD_RETRY_S__"] }],
    // Vitest rules match any top-level call; there are no tests in ts/.
    "vitest/require-hook": "off",
    // Fast-refresh boundary rule; the pages are bundled once, no HMR.
    "react/only-export-components": "off",
    // i18n extraction rule; the dashboard is operator-facing English only.
    "react/jsx-no-literals": "off",
    // Merges declarations into `let a, b`; per-declaration lines keep each
    // type annotation and blame line separate.
    "one-var": "off",
    // Its remaining suggestions are <output> for role="status" live regions,
    // which screen readers do not reliably announce, and <img> for a <canvas>.
    "jsx-a11y/prefer-tag-over-role": "off",
    // className is the shadcn merge prop (ADR 0041); shadcn/no-restyle above
    // decides which classes a call site may pass.
    "react/forbid-component-props": "off",
    // Components and helpers are function declarations, the shape the shadcn
    // registry primitives use and `shadcn add` emits.
    "func-style": "off"
  }
}
