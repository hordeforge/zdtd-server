# Binary / generated artifacts that must never be line-normalized or text-diffed.
# A checkout on any OS (e.g. Windows core.autocrlf) must preserve these bytes.

# Lance semantic-code index (semcode tool): binary columnar DB, regenerable.
.semcode.db/** -text
# Wasm plugin fixtures: compiled binaries.
*.wasm -text

# Executable text: a CRLF checkout breaks it outright (bash '\r': bad
# interpreter, make recipe tabs, zig fmt --check), so pin LF explicitly.
*.sh text eol=lf
*.py text eol=lf
Makefile text eol=lf
*.zig text eol=lf
build.zig.zon text eol=lf
.zigversion text eol=lf
presets/*.toml text eol=lf
