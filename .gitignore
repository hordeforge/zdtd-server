# Build artifacts
zig-out/
.zig-cache/
.zdtd_cfg_cache/
# Fetched Zig packages (zig fetch --global-cache-dir); regenerable, ~19 MB
zig-pkg/
*.o
*.a
# Release integrity sidecar (written next to zig-out/bin/zdtd by `make release`)
*.sha256

# Generated / test worlds (large; may embed game-derived world data)
worlds/

# Local server config (may hold ServerPassword; example is serverconfig.example.xml)
serverconfig.xml
**/serverconfig.xml

# Local zdtd operator tunables (example is zdtd.toml.example)
zdtd.toml
**/zdtd.toml
!zdtd.toml.example

# Secrets / local env (never commit)
.env
.env.*
!.env.example

# Full client id dump (game-derived data; kept local, not redistributed)
assets/fixtures/assignids_v314.txt

# Runtime playtest / local operator output (not src/server/)
/server/
*.pid

# Scenario / unit-test scratch left in the repo root. Tests should use
# std.testing.tmpDir instead; these patterns keep a stray run from showing up
# as untracked noise or, worse, getting committed.
.zdtd_test_*

# Local scratch / agent caches (not product inputs)
.cache_fixed_block_ids.txt
.ruff_cache/
.opencode/

# Editor / agent scratch
.claude.bak/

# Agent runtime state (locks, session)
.claude/
.review-loop.lock

# Installed npm packages (opencode tooling only; not part of the Zig build)
node_modules/
package.json
package-lock.json

# semcode index (rebuild with `semcode-index -s .`; not a product input)
.semcode.db/

# Python tooling (tools/*.py)
__pycache__/
*.pyc
